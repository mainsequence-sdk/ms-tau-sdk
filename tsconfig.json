{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true
  },
	"include": [
		"pi/extensions/**/*.ts",
		"pi/types/**/*.d.ts",
		"interface/**/*.ts",
		"adapters/**/*.ts",
		"bin/**/*.ts",
		"runtime/**/*.ts",
		"tests/**/*.ts",
	]
}
