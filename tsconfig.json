{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true
  },
  "include": [
    "pi/extensions/**/*.ts",
    "interface/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.d.ts"
  ]
}
