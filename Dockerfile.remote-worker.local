FROM python:3.11-slim AS astro-remote-worker-local

ARG ASTRO_RELEASE_VERSION=dev

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/node_modules/.bin:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    ASTRO_RELEASE_VERSION=${ASTRO_RELEASE_VERSION}

# =============================================================================
# [ASTRO] Install container dependencies for the local mounted-project executor
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gnupg \
    openssh-client \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json tsconfig.json ./
RUN npm install --include=dev --no-audit --no-fund \
 && npm cache clean --force

COPY .pi ./.pi
COPY pi ./pi
COPY interface ./interface
COPY scripts ./scripts

RUN npm run check

# =============================================================================
# [ASTRO] Install the Python-side runtime expected by Astro and project tools
# =============================================================================
ARG MAINSEQUENCE_PIP_SPEC=mainsequence
ENV MAINSEQUENCE_PIP_SPEC=${MAINSEQUENCE_PIP_SPEC}

RUN pip install --no-cache-dir "${MAINSEQUENCE_PIP_SPEC}" uv playwright \
 && playwright install --with-deps chromium

# =============================================================================
# [ASTRO] Create the local executor runtime layout
# =============================================================================
ENV APP_USER=jovyan \
    APP_GROUP=jovyan \
    APP_UID=10000 \
    APP_GID=10000 \
    APP_HOME=/home/jovyan \
    HOME=/home/jovyan \
    ASTRO_CONTAINER_DATA_DIR=/home/jovyan/.astro-container-data \
    ASTRO_STREAM_HOST=0.0.0.0 \
    ASTRO_STREAM_PORT=8787 \
    ASTRO_STREAM_SESSION_DIR=/session-state/sessions \
    ASTRO_SESSION_OVERRIDES_DIR=/session-state/session-overrides \
    ASTRO_MAINSEQUENCE_CONFIG_DIR=/home/jovyan/.astro-container-data/.config/mainsequence \
    PI_CODING_AGENT_DIR=/home/jovyan/.astro-container-data/.pi/agent \
    ASTRO_EXECUTION_MODE=remote_project_worker \
    ASTRO_FIXED_AGENT_TYPE=mainsequence-project-executor \
    ASTRO_FIXED_PROJECT_CWD=/workspace/project \
    ASTRO_PROJECT_IMAGE_REF=local-mounted-project

RUN groupadd --gid "${APP_GID}" "${APP_GROUP}" \
 && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --home-dir "${APP_HOME}" --shell /bin/bash "${APP_USER}" \
 && mkdir -p \
    "${APP_HOME}/.astro-container-data/.pi/agent/bin" \
    "${APP_HOME}/.astro-container-data/.config/mainsequence" \
    "${APP_HOME}/.local/share" \
    "${APP_HOME}/.pi" \
    "${APP_HOME}/.config" \
    "${APP_HOME}/.astro" \
    "/session-state/sessions" \
    "/session-state/session-overrides" \
    "/session-state/pi-agent-auth" \
    "/ms-playwright" \
    "/workspace/project" \
 && chown -R "${APP_USER}:${APP_GROUP}" "${APP_HOME}" /session-state /ms-playwright /workspace/project /app

USER jovyan

WORKDIR /workspace/project

EXPOSE 8787

CMD ["/app/node_modules/.bin/tsx", "/app/scripts/start_pi_stream.ts"]
