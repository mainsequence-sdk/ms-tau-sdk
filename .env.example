# Required Main Sequence connection and runtime credential. The projected workload identity token
# in the file below is the only proof of the credential; the file is read for every exchange.
MAINSEQUENCE_ENDPOINT=https://api.main-sequence.app
MAINSEQUENCE_AUTH_MODE=runtime_credential
MAINSEQUENCE_RUNTIME_CREDENTIAL_ID=replace-with-runtime-credential-id
MAINSEQUENCE_RUNTIME_IDENTITY_TOKEN_FILE=/var/run/secrets/mainsequence.io/runtime-identity/token

# Main Sequence sets these when it hosts the runtime, which then admits a request only with the
# platform's signed assertion. Do not set them yourself; local mode refuses to start with them.
# MAINSEQUENCE_CALLER_AUTH_MODE=assertion
# MAINSEQUENCE_CALLER_ASSERTION_ISSUER=<platform-issuer>
# MAINSEQUENCE_CALLER_ASSERTION_JWKS_URL=<https-url-of-the-platform-key-set>
# APP_NAME=<release-uid>
# MAINSEQUENCE_ORGANIZATION_ENVIRONMENT_UID=<organization-environment-uid>

# Optional process and workspace settings. Workspace defaults to the current directory.
MAINSEQUENCE_TAU_HOST=0.0.0.0
MAINSEQUENCE_TAU_PORT=8787
MAINSEQUENCE_TAU_WORKSPACE=/absolute/path/to/project
MAINSEQUENCE_TAU_A2A_ASSET_ROOT=/tmp/ms-tau-a2a-assets
# Writable root for durable Tau runtime state. Defaults to an XDG-style user state directory; set
# it when the home directory is not writable. Never point it inside the installed package.
# MAINSEQUENCE_TAU_STATE_ROOT=/absolute/path/to/writable/state
MAINSEQUENCE_TAU_SESSION_IDLE_TTL_SECONDS=900
MAINSEQUENCE_TAU_SESSION_LEASE_TTL_SECONDS=90
MAINSEQUENCE_TAU_SESSION_LEASE_RENEW_SECONDS=30
MAINSEQUENCE_TAU_TURN_TIMEOUT_SECONDS=900
MAINSEQUENCE_TAU_SHUTDOWN_GRACE_SECONDS=30
MAINSEQUENCE_TAU_MAX_TURN_OUTPUT_BYTES=4194304
MAINSEQUENCE_TAU_A2A_TASK_OUTPUT_FLUSH_INTERVAL_MS=200
MAINSEQUENCE_TAU_A2A_TASK_OUTPUT_FLUSH_BYTES=8192
MAINSEQUENCE_TAU_A2A_TASK_EVENT_POLL_SECONDS=0.5
MAINSEQUENCE_TAU_A2A_TASK_WAIT_TIMEOUT_SECONDS=30
MAINSEQUENCE_TAU_LOG_LEVEL=INFO
MAINSEQUENCE_TAU_LOG_MACHINE_SINK=false
MAINSEQUENCE_TAU_LOG_HUMAN_SINK=true
MAINSEQUENCE_TAU_LOG_PAYLOADS=false

# Optional browser CORS origins, comma-separated.
# MAINSEQUENCE_TAU_TRUSTED_ORIGINS=http://localhost:5173

# Local development alternative. Do not enable these together with managed runtime credentials.
# No token belongs in this file. Log in once with `mainsequence login`: the Main Sequence CLI
# keeps the session in the operating system credential store, and local mode asks the CLI for a
# short-lived access token. ms-tau-sdk does not depend on the mainsequence Python package.
# Launchers and CI may instead export MAINSEQUENCE_ACCESS_TOKEN and MAINSEQUENCE_REFRESH_TOKEN
# in the process environment.
# TAU_LOCAL_MODE=true
# MAINSEQUENCE_AUTH_MODE=jwt
# Optional path to the Main Sequence CLI. Without it the SDK looks beside the Python interpreter,
# then on PATH.
# MAINSEQUENCE_CLI=/absolute/path/to/mainsequence
# TAU_LOCAL_PROVIDER=openai
# TAU_LOCAL_MODEL=gpt-5.4
# TAU_LOCAL_THINKING=high
# TAU_LOCAL_STATE_ROOT=/absolute/path/outside/the/project
# TAU_LOCAL_A2A_TASK_RECONCILE_INTERVAL_SECONDS=5
# TAU_LOCAL_A2A_TASK_STALE_AFTER_SECONDS=120
# TAU_LOCAL_A2A_TASK_PENDING_TIMEOUT_SECONDS=300
# TAU_LOCAL_A2A_TASK_MAX_RECOVERY_ATTEMPTS=3
