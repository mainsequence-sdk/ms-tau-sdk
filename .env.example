# Required Main Sequence connection and runtime credential.
MAINSEQUENCE_BACKEND=https://api.main-sequence.app
MAINSEQUENCE_AUTH_MODE=runtime_credential
MAINSEQUENCE_RUNTIME_CREDENTIAL_ID=replace-with-runtime-credential-id
MAINSEQUENCE_RUNTIME_CREDENTIAL_SECRET=replace-with-runtime-credential-secret

# Optional process and workspace settings. Workspace defaults to the current directory.
MAINSEQUENCE_TAU_HOST=0.0.0.0
MAINSEQUENCE_TAU_PORT=8787
MAINSEQUENCE_TAU_WORKSPACE=/absolute/path/to/project
MAINSEQUENCE_TAU_A2A_ASSET_ROOT=/tmp/ms-tau-a2a-assets
MAINSEQUENCE_TAU_SESSION_IDLE_TTL_SECONDS=900
MAINSEQUENCE_TAU_SESSION_LEASE_TTL_SECONDS=90
MAINSEQUENCE_TAU_SESSION_LEASE_RENEW_SECONDS=30
MAINSEQUENCE_TAU_TURN_TIMEOUT_SECONDS=900
MAINSEQUENCE_TAU_SHUTDOWN_GRACE_SECONDS=30
MAINSEQUENCE_TAU_MAX_TURN_OUTPUT_BYTES=4194304
MAINSEQUENCE_TAU_A2A_TASK_OUTPUT_FLUSH_INTERVAL_MS=200
MAINSEQUENCE_TAU_A2A_TASK_OUTPUT_FLUSH_BYTES=8192
MAINSEQUENCE_TAU_A2A_TASK_EVENT_POLL_SECONDS=0.5
MAINSEQUENCE_TAU_LOG_LEVEL=INFO
MAINSEQUENCE_TAU_LOG_MACHINE_SINK=false
MAINSEQUENCE_TAU_LOG_HUMAN_SINK=true
MAINSEQUENCE_TAU_LOG_PAYLOADS=false

# Optional browser CORS origins, comma-separated.
# MAINSEQUENCE_TAU_TRUSTED_ORIGINS=http://localhost:5173
