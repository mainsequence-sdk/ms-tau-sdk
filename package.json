{
  "name": "astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Astro orchestrator for Main Sequence project assistants with generated docs context and standard Pi web access.",
  "keywords": [
    "pi-package",
    "pi",
    "astro",
    "main-sequence",
    "coding-agent",
    "extensions"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "version:show": "node -p \"require('./package.json').version\"",
    "version:major": "npm version major --no-git-tag-version",
    "version:patch": "npm version patch --no-git-tag-version",
    "build:gcp": "gcloud builds submit --config deployment/gcp/cloudbuild.yaml .",
    "pi": "node scripts/start_pi.mjs",
    "pi:stream": "tsx scripts/start_pi_stream.ts",
    "checkpoint:sidecar": "tsx scripts/session_checkpoint_sidecar.ts"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi/extensions/hooks",
      "./pi/extensions/tools"
    ],
    "prompts": [
      "./pi/prompts"
    ],
    "skills": [
      "./pi/skills"
    ]
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.58.1",
    "@mozilla/readability": "0.5.0",
    "@sinclair/typebox": "^0.34.48",
    "linkedom": "0.16.11",
    "p-limit": "6.2.0",
    "pi-web-access": "0.10.6",
    "tsx": "^4.21.0",
    "turndown": "7.2.2",
    "typescript": "^5.9.3",
    "unpdf": "1.4.0"
  }
}
