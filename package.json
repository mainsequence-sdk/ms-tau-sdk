{
  "name": "astro",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "Astro deployment runtime for Pi agents with HTTP streaming, runtime state, and standard Pi web access.",
  "keywords": [
    "pi-package",
    "pi",
    "astro",
    "coding-agent",
    "extensions"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "version:show": "node -p \"require('./package.json').version\"",
    "version:major": "npm version major --no-git-tag-version",
    "version:patch": "npm version patch --no-git-tag-version",
    "patch:pi-rpc": "node tools/build/patch-pi-rpc-ready.mjs",
    "build:gcp": "gcloud builds submit --config deployment/gcp/cloudbuild.yaml .",
    "pi": "tsx bin/astro-pi-local.ts",
    "pi:stream": "tsx bin/astro-stream.ts",
    "checkpoint:sidecar": "tsx runtime/checkpoints/sidecar.ts"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi/extensions/hooks/agent-registration",
      "./pi/extensions/hooks/session-model",
      "./pi/extensions/hooks/telemetry",
      "./pi/extensions/tools/runtime-info"
    ]
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.58.1",
    "@mozilla/readability": "0.5.0",
    "@sinclair/typebox": "^0.34.48",
    "linkedom": "0.16.11",
    "p-limit": "6.2.0",
    "pi-web-access": "0.10.6",
    "tsx": "^4.21.0",
    "turndown": "7.2.2",
    "typescript": "^5.9.3",
    "unpdf": "1.4.0"
  }
}
