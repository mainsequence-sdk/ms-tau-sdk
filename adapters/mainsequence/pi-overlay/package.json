{
  "name": "@mainsequence/astro-pi-overlay",
  "version": "0.0.0",
  "private": true,
  "description": "Main Sequence adapter-owned Pi resource overlay for Astro deployments.",
  "type": "module",
  "keywords": [
    "pi-package",
    "mainsequence"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi/extensions/hooks/scaffold-skill-discovery",
      "./pi/extensions/hooks/project-policy",
      "./pi/extensions/tools/mainsequence-cli-auth",
      "./pi/extensions/tools/mainsequence-runtime-info"
    ],
    "prompts": [
      "./pi/prompts"
    ]
  }
}
