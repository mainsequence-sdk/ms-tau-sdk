# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
ARG EXECUTOR_BUNDLE_IMAGE
ARG ASTRO_EXECUTOR_BUNDLE_REF=latest

FROM ${EXECUTOR_BUNDLE_IMAGE} AS astro-executor-bundle

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG ASTRO_EXECUTOR_BUNDLE_REF
ARG SOURCE_COMMIT_SHA
ARG SOURCE_REPOSITORY_BRANCH
ARG SOURCE_REPOSITORY_REF

USER root

COPY --from=astro-executor-bundle /app /app
COPY --from=astro-executor-bundle /opt/wheels /opt/wheels

# Astro and project dependencies intentionally share the base image's Python
# environment. Images older than Python 3.13 are rejected rather than receiving
# a second interpreter or a private /opt/astro environment.
RUN python -c "import sys; assert sys.version_info >= (3, 13), 'BASE_IMAGE must provide Python >=3.13'" \
 && command -v ffmpeg \
 && command -v ffprobe \
 && command -v git

USER ${NB_USER}
RUN set -euo pipefail; \
    cd "${SKEL_APP_DIR}"; \
    git diff --quiet --ignore-submodules HEAD --; \
    git diff --cached --quiet --ignore-submodules HEAD --; \
    test -n "${SOURCE_COMMIT_SHA}"; \
    test -n "${SOURCE_REPOSITORY_BRANCH}"; \
    test "${SOURCE_REPOSITORY_REF}" = "refs/heads/${SOURCE_REPOSITORY_BRANCH}"; \
    test "$(git branch --show-current)" = "${SOURCE_REPOSITORY_BRANCH}"; \
    test "$(git symbolic-ref HEAD)" = "${SOURCE_REPOSITORY_REF}"; \
    test "$(git rev-parse HEAD)" = "${SOURCE_COMMIT_SHA}"

USER root
RUN python -m pip install \
    --no-index \
    --find-links /opt/wheels \
    /opt/wheels/mainsequence_astro-*.whl

ENV ASTRO_RELEASE_VERSION=${ASTRO_EXECUTOR_BUNDLE_REF} \
    HOME=/home/${NB_USER} \
    ASTRO_HOME=/home/${NB_USER} \
    ASTRO_HOST=0.0.0.0 \
    ASTRO_PORT=8787 \
    ASTRO_PROJECT_CWD=${SKEL_APP_DIR} \
    ASTRO_FIXED_PROJECT_CWD=${SKEL_APP_DIR} \
    ASTRO_PROJECT_IMAGE_REF=${BASE_IMAGE} \
    ASTRO_A2A_ASSET_ROOT=/tmp/astro-a2a-assets \
    ASTRO_SESSION_ASSET_ROOT=/tmp/astro-session-assets

RUN mkdir -p /tmp/astro-a2a-assets /tmp/astro-session-assets \
 && chown -R 10000:10000 \
    ${APP_DIR} \
    ${SKEL_APP_DIR} \
    /home/${NB_USER} \
    /tmp/astro-a2a-assets \
    /tmp/astro-session-assets

USER 10000:10000
WORKDIR ${SKEL_APP_DIR}

EXPOSE 8787

CMD ["astro-stream"]
