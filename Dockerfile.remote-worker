# syntax=docker/dockerfile:1.4

# =============================================================================
# [ASTRO] Stage 1: Build the Astro runtime bundle
# Purpose:
#   - Build Astro's Node-side runtime once
#   - Produce a self-contained /astro bundle we can copy into the final image
# =============================================================================
FROM node:20-bookworm-slim AS astro-runtime-bundle

WORKDIR /astro

COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --include=dev --no-audit --no-fund

COPY .pi ./.pi
COPY pi ./pi
COPY interface ./interface
COPY scripts ./scripts

RUN npm run check


# =============================================================================
# [EXISTING] Stage 2: Main Sequence project scaffold
# Purpose:
#   - Start from your existing BASE_IMAGE
#   - Clone the project repo
#   - Install the project's Python dependencies
#   - Preserve APP_DIR / SKEL_APP_DIR / NB_* exactly as they work today
# =============================================================================
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-lc"]

ARG BASE_IMAGE

# Build args from your dynamic step
ARG GIT_URL
ARG GIT_BRANCH
ARG GIT_HASH

# Paths
ENV APP_DIR=/home/${NB_USER}/app \
    SKEL_DIR=/usr/local/share/user-skel \
    SKEL_APP_DIR=/usr/local/share/user-skel/app \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

USER root
RUN mkdir -p "${APP_DIR}" "${SKEL_APP_DIR}" \
 && chown -R ${NB_UID}:${NB_GID} "${APP_DIR}" "${SKEL_DIR}" \
 && chmod -R a+rX "${SKEL_DIR}"
RUN pip install --no-cache-dir uv || true

USER ${NB_USER}
WORKDIR ${SKEL_APP_DIR}

# --- Clone using SSH private key provided as a BuildKit secret ---
# Build step must pass: --secret id=ssh_private,src=/workspace/_ssh_private
RUN --mount=type=secret,id=ssh_private,uid=1000,gid=100,mode=0400 \
    set -euo pipefail; \
    mkdir -p /tmp/ssh && \
    ssh-keyscan -t rsa,ecdsa,ed25519 github.com > /tmp/ssh/known_hosts && \
    ssh-keygen -y -f /run/secrets/ssh_private >/dev/null 2>&1 || { echo 'Invalid SSH private key' >&2; exit 1; } && \
    CLEAN_GIT_URL=$(echo -n "${GIT_URL}" | tr -dc '[:print:]') && \
    export GIT_SSH_COMMAND="ssh -i /run/secrets/ssh_private \
                         -o IdentitiesOnly=yes \
                         -o StrictHostKeyChecking=yes \
                         -o UserKnownHostsFile=/tmp/ssh/known_hosts" && \
    git clone --filter=blob:none --single-branch --branch "${GIT_BRANCH}" "${CLEAN_GIT_URL}" . && \
    git checkout -B "${GIT_BRANCH}" "${GIT_HASH}" && \
    git branch -M "${GIT_BRANCH}" && \
    git rev-parse --short HEAD | tee "${SKEL_APP_DIR}/.app_git_rev" && \
    rm -rf /tmp/ssh


# --- Install dependencies if present ---
RUN set -euo pipefail; \
    if [ -f requirements.txt ]; then \
        uv pip install -r requirements.txt; \
    elif [ -f pyproject.toml ]; then \
        uv pip install -e . || pip install -e .; \
    else \
        echo "[deps] nothing to install"; \
    fi

# --- Runtime env ---
ENV TDAG_CONFIG_PATH=/home/${NB_USER}/tdag/default_config.yml \
    TDAG_RAY_CLUSTER_ADDRESS=ray://localhost:10001 \
    TDAG_RAY_API_ADDRESS=http://localhost:8265 \
    TDAG_RAY_SERVE_HOST=0.0.0.0 \
    TDAG_RAY_SERVE_PORT=8003 \
    MLFLOW_ENDPOINT=http://localhost:5000


# =============================================================================
# [ASTRO] Stage 3: Overlay Astro into the already-built project image
# Purpose:
#   - Keep the project runtime exactly as-is
#   - Add Astro alongside it
# Key path split:
#   - ${APP_DIR} = project code/runtime
#   - /app       = Astro runtime
# =============================================================================
USER root

# If BASE_IMAGE already includes Node 20+, this block can be removed later.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    openssh-client \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

COPY --from=astro-runtime-bundle /astro /app

ENV PATH="/app/node_modules/.bin:${PATH}" \
    HOME=/home/${NB_USER} \
    ASTRO_CONTAINER_DATA_DIR=/home/${NB_USER}/.astro-container-data \
    ASTRO_STREAM_HOST=0.0.0.0 \
    ASTRO_STREAM_PORT=8787 \
    ASTRO_STREAM_SESSION_DIR=/session-state/sessions \
    ASTRO_SESSION_OVERRIDES_DIR=/session-state/session-overrides \
    ASTRO_MAINSEQUENCE_CONFIG_DIR=/home/${NB_USER}/.astro-container-data/.config/mainsequence \
    PI_CODING_AGENT_DIR=/home/${NB_USER}/.astro-container-data/.pi/agent \
    ASTRO_EXECUTION_MODE=remote_project_worker \
    ASTRO_FIXED_AGENT_NAME=mainsequence-project-executor \
    ASTRO_FIXED_PROJECT_CWD=${APP_DIR} \
    ASTRO_PROJECT_IMAGE_REF=${BASE_IMAGE}

RUN mkdir -p \
    /home/${NB_USER}/.astro-container-data/.pi/agent/bin \
    /home/${NB_USER}/.astro-container-data/.config/mainsequence \
    /home/${NB_USER}/.local/share \
    /home/${NB_USER}/.pi \
    /home/${NB_USER}/.config \
    /home/${NB_USER}/.astro \
    /session-state/sessions \
    /session-state/session-overrides \
 && chown -R ${NB_UID}:${NB_GID} \
    /home/${NB_USER}/.astro-container-data \
    /home/${NB_USER}/.local \
    /home/${NB_USER}/.pi \
    /home/${NB_USER}/.config \
    /home/${NB_USER}/.astro \
    /session-state \
    /app

USER ${NB_USER}
WORKDIR ${APP_DIR}

EXPOSE 8787

CMD ["/app/node_modules/.bin/tsx", "/app/scripts/start_pi_stream.ts"]
